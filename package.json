{
  "name": "megastructures-tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Interactive engineering films for Fire TV: D-pad chapters, a TV performance mode and a voice question loop that changes the live simulation.",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:tv": "vite --config tv/vite.config.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build --config tv/vite.config.mjs",
    "typecheck": "tsc -p tv/tsconfig.json --noEmit && tsc -p packages/megastructures-engine/tsconfig.json --noEmit",
    "test": "node --test server/test/*.test.mjs && node scripts/smoke.mjs",
    "test:unit": "node --test server/test/*.test.mjs",
    "perf": "node scripts/perf.mjs",
    "record:answers": "node --env-file-if-exists=.env scripts/record-answers.mjs",
    "film": "node scripts/film.mjs"
  },
  "dependencies": {
    "megastructures-engine": "0.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  }
}
