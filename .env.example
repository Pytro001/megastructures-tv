# Amazon Bedrock (Converse API with a Bedrock API key / bearer token)
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# ask = call Bedrock for every question, replay = answer from server/recordings, mock = keyword rules (no network)
VOICE_MODE=ask
# browser = speechSynthesis in the page, polly = Amazon Polly through /api/tts (needs AWS SigV4 credentials, see README)
TTS_PROVIDER=browser
POLLY_VOICE=Joanna
PORT=8302
